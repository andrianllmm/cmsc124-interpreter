true and true;       # expect: true
true and false;      # expect: false
1.0 and 0.0;         # expect: false
5.6 and 3.1;         # expect: true
6 and 0;             # expect: false
6 and 7;             # expect: true
"hello" and "world"; # expect: true
"hello" and "";      # expect: false
false and 1 / 0;     # expect: false
