1 < 2;     # expect: true
2 < 1;     # expect: false
1 < 1;     # expect: false
1 <= 1;    # expect: true
1 <= 2;    # expect: true
2 <= 1;    # expect: false
2 > 1;     # expect: true
1 > 2;     # expect: false
1 > 1;     # expect: false
1 >= 1;    # expect: true
2 >= 1;    # expect: true
1 >= 2;    # expect: false
1 < 1.5;   # expect: true
1.5 < 1;   # expect: false
1 < 1.0;   # expect: false
1 <= 1.0;  # expect: true
1.0 > 1;   # expect: false
1.0 >= 1;  # expect: true
2.5 > 2.4; # expect: true
-1 < 0;    # expect: true
