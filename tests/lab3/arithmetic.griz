1 + 2;      # expect: 3
3 + 4.0;    # expect: 7.0
5.5 + 6;    # expect: 11.5
7.7 + 8.8;  # expect: 16.5
1 - 2;      # expect: -1
3 - 4.4;    # expect: -1.4000000000000004
5.5 - 6;    # expect: -0.5
7.7 - 8.8;  # expect: -1.1000000000000005
1 * 2;      # expect: 2
3 * 4.4;    # expect: 13.200000000000001
5.5 * 6;    # expect: 33.0
7.7 * 8.8;  # expect: 67.76
1 / 1;      # expect: 1
6 / 3.0;    # expect: 2.0
15.0 / 5;   # expect: 3.0
28.0 / 7.0; # expect: 4.0
1 % 2;      # expect: 1
2 % 3.0;    # expect: 2.0
4.0 % 5;    # expect: 4.0
6.0 % 7.0;  # expect: 6.0
1 ^ 2;      # expect: 1
3 ^ 4.0;    # expect: 81.0
5.0 ^ 6;    # expect: 15625.0
7.0 ^ 8.0;  # expect: 5764801.0
