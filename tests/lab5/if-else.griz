if true { print("then"); } else { print("else"); }    # expect: then
if false { print("then"); } else { print("else"); }   # expect: else
if 0 { print("then"); } else { print("else"); }       # expect: else
if "" { print("then"); } else { print("else"); }      # expect: else
if 0.0 { print("then"); } else { print("else"); }     # expect: else
if null { print("then"); } else { print("else"); }    # expect: else
